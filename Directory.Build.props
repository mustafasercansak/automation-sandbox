<Project>

  <!-- Shared metadata for dotnet pack. Only applies where IsPackable isn't overridden
       to false (the two demo apps, NUnitFixtureTests, the samples, and ScenarioRunner as an IsTestProject). -->

  <PropertyGroup>

    <Authors>Mustafa Sercan Sak</Authors>

    <RepositoryUrl>https://github.com/mustafasercansak/automation-sandbox</RepositoryUrl>

    <RepositoryType>git</RepositoryType>

    <PackageProjectUrl>https://github.com/mustafasercansak/automation-sandbox</PackageProjectUrl>

    <PackageTags>ui-automation;flaui;self-healing;test-automation</PackageTags>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <IncludeSymbols>true</IncludeSymbols>

    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <Version>0.2.0-beta.4</Version>

    <Deterministic>true</Deterministic>

    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package security audit (#223): NuGetAudit checks every direct and transitive
         package on every restore. Locally this only warns, so it never blocks dev work.
         In CI (ContinuousIntegrationBuild == true, set above), High/Critical advisories
         (NU1903 direct, NU1904 transitive) are promoted to build errors so a vulnerable
         dependency cannot merge to main. See AGENTS.md "Security considerations". -->
    <NuGetAudit>true</NuGetAudit>

    <NuGetAuditMode>all</NuGetAuditMode>

    <NuGetAuditLevel>moderate</NuGetAuditLevel>

    <WarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>

  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
