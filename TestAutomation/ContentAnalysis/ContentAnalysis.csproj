<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([System.Version]::Parse('$(NETCoreSdkVersion)').Major) >= 10">netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AutomationSandbox.ContentAnalysis</RootNamespace>

    <PackageId>AutomationSandbox.ContentAnalysis</PackageId>
    <Description>Content-quality checks over a captured WebElementInfo tree: zero-dependency heuristics (duplicate words, leftover template placeholders, malformed punctuation) plus an optional single-provider LLM review for grammar and meaning issues the heuristics can't judge.</Description>
    <PackageTags>content-analysis;web-automation;quality;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiModel\UiModel.csproj" />
    <ProjectReference Include="..\WebDiscovery\WebDiscovery.csproj" />
  </ItemGroup>

</Project>
