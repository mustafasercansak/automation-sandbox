<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([System.Version]::Parse('$(NETCoreSdkVersion)').Major) >= 10">netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>AutomationSandbox.IntentAutomation</PackageId>
    <Description>Intent contracts, deterministic planning, DOM matching, locator recording, Playwright C#/TypeScript generation, intent flow reports, and pipeline orchestration for intent-driven test automation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiModel\UiModel.csproj" />
    <ProjectReference Include="..\WebDiscovery\WebDiscovery.csproj" />
  </ItemGroup>

</Project>
