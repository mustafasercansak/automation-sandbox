<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AutomationSandbox.IntentExecution</RootNamespace>

    <PackageId>AutomationSandbox.IntentExecution</PackageId>
    <Description>Live executor that plans an IntentAutomation scenario, matches each step against a fresh PlaywrightWebSession capture, and actually performs the action - closing the loop between intent planning/codegen and real browser execution.</Description>
    <PackageTags>intent-driven;test-automation;playwright;web-automation;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebDiscovery\WebDiscovery.csproj" />
    <ProjectReference Include="..\IntentAutomation\IntentAutomation.csproj" />
    <ProjectReference Include="..\PlaywrightLiveExploration\PlaywrightLiveExploration.csproj" />
  </ItemGroup>

</Project>
