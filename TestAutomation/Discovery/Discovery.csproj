<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>

    <TargetFrameworks Condition="$([System.Version]::Parse('$(NETCoreSdkVersion)').Major) >= 10">net48;net8.0-windows;net10.0-windows</TargetFrameworks>

    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <LangVersion>latest</LangVersion>

    <ImplicitUsings>enable</ImplicitUsings>

    <Nullable>enable</Nullable>

    <PackageId>AutomationSandbox.Discovery</PackageId>

    <Description>Resilient live UI tree capture and application startup diagnostics via FlaUI/UI Automation for Windows desktop (net48 and net8.0-windows; Windows required at build and run time).</Description>

    <PackageTags>ui-automation;flaui;uia3;test-automation;windows;desktop;self-healing;dotnet</PackageTags>

  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="FlaUI.Core" Version="5.0.0" />

    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />

  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\UiModel\UiModel.csproj" />

  </ItemGroup>

</Project>
