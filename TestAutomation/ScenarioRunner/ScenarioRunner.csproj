<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net48;net8.0</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure BCL logic of the site audit CLI (a net8.0-only tool, so it cannot be referenced from the
         net48 build); compiled in directly so its argument and path-safety rules are unit tested. -->
    <Compile Include="..\SiteAuditCli\DictionaryLocation.cs" Link="SiteAuditCli\DictionaryLocation.cs" />
    <Compile Include="..\SiteAuditCli\AuditOptions.cs" Link="SiteAuditCli\AuditOptions.cs" />
    <Compile Include="..\AgentCli\AgentOptions.cs" Link="AgentCli\AgentOptions.cs" />
    <Compile Include="..\AgentCli\AgentCommand.cs" Link="AgentCli\AgentCommand.cs" />
    <!-- The MCP server (#586) is a net8.0-only tool too; its protocol loop and tools are compiled in for the same reason. -->
    <Compile Include="..\McpServer\McpProtocol.cs" Link="McpServer\McpProtocol.cs" />
    <Compile Include="..\McpServer\McpTools.cs" Link="McpServer\McpTools.cs" />
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\spelling\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\docbench\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SelfHealing\SelfHealing.csproj" />
    <ProjectReference Include="..\UiModel\UiModel.csproj" />
    <ProjectReference Include="..\LlmHealing\LlmHealing.csproj" />
    <ProjectReference Include="..\WebDiscovery\WebDiscovery.csproj" />
    <ProjectReference Include="..\IntentAutomation\IntentAutomation.csproj" />
    <ProjectReference Include="..\PlaywrightLiveExploration\PlaywrightLiveExploration.csproj" />
    <ProjectReference Include="..\ContentAnalysis\ContentAnalysis.csproj" />
    <ProjectReference Include="..\IntentExecution\IntentExecution.csproj" />
    <ProjectReference Include="..\Discovery\Discovery.csproj" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Compile Remove="MainFormScenarioTests.cs" />
    <Compile Remove="WpfMainWindowScenarioTests.cs" />
    <Compile Remove="DiscoveryRobustnessTests.cs" />
    <Compile Remove="UiTreeWalkerExceptionResilienceTests.cs" />
    <Compile Remove="LlmHealingEvaluationTests.cs" />
    <Compile Remove="WindowsAppSurveyRunner.cs" />
    <Compile Remove="WindowsAppSurveyLiveTests.cs" />
    <Compile Remove="OpenSourceAppSurveyRunner.cs" />
    <Compile Remove="OpenSourceAppSurveyLiveTests.cs" />
  </ItemGroup>

</Project>
