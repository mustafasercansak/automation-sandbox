<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AutomationSandbox.SelfHealingCli</RootNamespace>

    <!-- No GenerateDocumentationFile: the public surface here is the CLI argument shape
         and the JSON it reads/writes, not a C# API, so this project does not inherit the
         libraries' XML-doc-as-build-error gate (Directory.Build.targets only wires that
         gate in for projects that opt into GenerateDocumentationFile themselves). -->

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>automation-sandbox-heal</ToolCommandName>
    <PackageId>AutomationSandbox.Cli</PackageId>
    <Description>Language- and platform-agnostic command-line locator healing: feed it two JSON UI-tree snapshots (any tool in any language can produce them), get a heal decision back as JSON - no C# project, no FlaUI/Playwright .NET reference required on the caller's side.</Description>
    <PackageTags>self-healing;locator-healing;test-automation;cli;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiModel\UiModel.csproj" />
    <ProjectReference Include="..\SelfHealing\SelfHealing.csproj" />
  </ItemGroup>

</Project>
