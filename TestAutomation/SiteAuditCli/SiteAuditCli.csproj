<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AutomationSandbox.SiteAuditCli</RootNamespace>

    <!-- No GenerateDocumentationFile: the public surface is the CLI argument shape and its
         report files, not a C# API (same reasoning as SelfHealingCli). -->

    <!-- NU5111: the packed tool carries the Playwright driver's own .ps1 files under tools/<tfm>/any/, and
         NuGet warns that none is an install/uninstall/init hook. They are driver scripts, never meant to run
         at install time, so the warning is noise (about ten per pack, repeated in every CI job and in the
         typo-audit action's job summary). -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>automation-sandbox-audit</ToolCommandName>
    <PackageId>AutomationSandbox.SiteAudit</PackageId>
    <Description>Crawl a website from one URL and report spelling mistakes (Hunspell dictionaries such as Turkish and English, no API key, nothing leaves your machine) plus leftover placeholders and duplicate words, as a JSON Lines log and an HTML report. Built for CI: exit code 1 when findings exist.</Description>
    <PackageTags>spell-check;content-quality;website-audit;playwright;cli;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiModel\UiModel.csproj" />
    <ProjectReference Include="..\WebDiscovery\WebDiscovery.csproj" />
    <ProjectReference Include="..\PlaywrightLiveExploration\PlaywrightLiveExploration.csproj" />
    <ProjectReference Include="..\ContentAnalysis\ContentAnalysis.csproj" />
  </ItemGroup>

</Project>
