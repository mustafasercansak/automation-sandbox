<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Registration Form (WPF)" Height="480" Width="460"
        ResizeMode="CanMinimize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="First Name:" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFirstName" AutomationProperties.AutomationId="txtFirstName" Margin="0,4" />

        <Label Grid.Row="1" Grid.Column="0" Content="Last Name:" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtLastName" AutomationProperties.AutomationId="txtLastName" Margin="0,4" />

        <Label Grid.Row="2" Grid.Column="0" Content="Email:" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtEmail" AutomationProperties.AutomationId="txtEmail" Margin="0,4" />

        <Label Grid.Row="3" Grid.Column="0" Content="Record Type:" VerticalAlignment="Center" />
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbRecordType" AutomationProperties.AutomationId="cmbRecordType"
                  Margin="0,4" SelectionChanged="CmbRecordType_SelectionChanged">
            <ComboBoxItem Content="Individual" />
            <ComboBoxItem Content="Corporate" />
        </ComboBox>

        <!-- CompanyPanel: deliberately has no explicit AutomationProperties.AutomationId set.
             WPF's FrameworkElementAutomationPeer falls back to FrameworkElement.Name
             (i.e. x:Name) when no explicit AutomationId is provided, so this GroupBox
             is reachable as AutomationId="CompanyPanel". The brittle-locator case study
             here is that renaming x:Name silently changes the AutomationId, breaking any
             automation that relied on it without the developer noticing. GroupBox also
             has its own automation peer (ControlType.Group), so it is discoverable
             structurally even if the AutomationId changes. -->
        <GroupBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="CompanyPanel" Visibility="Collapsed" Margin="0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Company Name:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="TxtCompanyName" AutomationProperties.AutomationId="txtCompanyName" />
            </Grid>
        </GroupBox>

        <Button Grid.Row="5" Grid.Column="1" x:Name="BtnSave" AutomationProperties.AutomationId="btnSave"
                Content="Save" Width="100" HorizontalAlignment="Left" Margin="0,8" Click="BtnSave_Click" />

        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TxtValidationSummary"
                   AutomationProperties.AutomationId="txtValidationSummary"
                   Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />

        <DataGrid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" x:Name="DgvRecords"
                  AutomationProperties.AutomationId="dgvRecords"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" />
                <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160" />
                <DataGridTextColumn Header="Record Type" Binding="{Binding RecordType}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
